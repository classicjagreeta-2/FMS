@model  WebAppFileMange.Models.Master.Mast_File_Hierarchy

@{
    Layout = null;
}
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/bootstrap/css/bootstrap.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/font-awesome/css/font-awesome.min.css">
<!-- Select 2 css -->
<link rel="stylesheet" href="~/libraries/bower_components/select2/css/select2.min.css">
<link href="~/libraries/smoke-v3.1.1/css/smoke.css" rel="stylesheet" />
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<div class="modal-dialog modal-lg" role="document">


    @*@using (Ajax.BeginForm("StoreOrEdit", "Master_Customer", new AjaxOptions
        { OnSuccess = "OnSuccess", OnBegin = "OnBegin",OnFailure= "OnFailure" }, new {
            onsubmit = "return SubmitForm(this)" }))*@
    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))

    {

        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Hierarchy Master</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="card-block">

                    <div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="exampleInputName11">Parent Hierarchy*</label>
                                    @Html.DropDownListFor(x => x.PARENTID, new SelectList(ViewBag.DropdownListMasterHierarchy, "AUTOID", "HIERARCHY_NAME"),
                                        "SELECT..", new { @class = "js-example-responsive", @id = "ddlPt", @required = "required"})
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="exampleInputName11">Child Hierarchy Name*</label>
                                    @Html.TextBoxFor(x => x.HIERARCHY_NAME, new { @class = "form-control", @maxlength = "50", @required = "required" })
                                    @Html.HiddenFor(x => x.AUTOID)
                                    @Html.HiddenFor(x => x.HIERARCHY_DESCN)
                                    @Html.HiddenFor(x => x.PK_CODE)
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <div class="checkbox-fade fade-in-primary">
                                        @Html.CheckBoxFor(x => x.HIERARCHY_GROUP)
                                        <span>Hierarchy Parent</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>


            </div>
            <div class="modal-footer">
                <div id="divMsg" class="text-danger"> </div>

                <button type="button" class="btn btn-default waves-effect" id="btnclose" data-dismiss="modal">Close</button>
                <button name="submit" type="submit" id="btnSubmit" class="btn btn-grd-info pull-right"><i class="icofont icofont-check-circled"></i>SUBMIT</button>
            </div>
        </div>
    }
</div>


 
<script src="~/libraries/assets/js/select2.js"></script>
<!-- Multiselect js -->
<!-- Custom js -->
<script type="text/javascript" src="~/libraries/assets/pages/advance-elements/select2-custom.js"></script>
<script src="~/libraries/smoke-v3.1.1/js/smoke.js"></script>
<script src="~/libraries/js/loader/jquery.blockUI.js"></script>

<script>
    $("#btnclose").click(function () {
        debugger;
        $('#IdModal').hide();
    })
    $('#btnSubmit').click(function (e) {
        e.preventDefault();
        var IstoVlidate = 'form';
        //debugger;
        if ($(IstoVlidate).smkValidate()) {
            var dataString = new FormData($("#myForm").get(0));
            blockUIStart();
            $.ajax({
                url: "/FMS_HierarchyMaster/HierarchyStoreOrEdit",
                data: dataString,
                contentType: false,
                processData: false,
                cache: false,
                type: "POST",
                dataType: "json",
                success: function (data) {

                    OnSuccess1(data);
                },
                error: function (xhr, ajaxOptions, thrownError) {
                    OnFailure(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
                }
            });
        }
    });

    function OnBegin() {
        blockUIStart();
    }

    function OnSuccess1(result) {
        debugger;

        $.unblockUI();
        $('#IdModal').hide();
        msgSuccess(result.message);
        var url = '/FMS_HierarchyMaster/HierarchyMaster';
        window.location.href = url;
    }


    function OnFailure(result) {
        $.unblockUI();

    }
</script>

