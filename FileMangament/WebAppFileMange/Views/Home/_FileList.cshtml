                         action: function (e, dt, node, config) {

                             var url = '/CommonDashBoard/CommonDashBoard';
                             window.location.href = url;


                         }
                        },
                        {
                            text: '<i class="icofont icofont-download"></i> EXPORT EXCEL ',
                            extend: 'excelHtml5',
