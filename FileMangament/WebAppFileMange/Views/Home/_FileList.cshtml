                              orderable: false,
                              data: null,
                              defaultContent: ''
                          },
                               {
                                   data: "Autoid", "render": function (data, type, full, meta) {
                                       debugger;
                                       return "<a class='btn btn-sm btn-inverse btn-outline-inverse btnLoader " + full.Autoid + "'\
                                       onclick=PopupForm('" + full.Hierarchy + "','" + full.Hierarchy2 + "','" + full.Autoid + "')>EDIT</a>";
                                   }
                               },
                        { title: 'ID', data: "Autoid", "name": "Autoid" },
                        { title: 'FLOOR', data: "HCol2_descn", "name": "HCol2_descn" },
                        { title: 'RACK', data: "HCol3_descn", "name": "HCol3_descn" },
                        { title: 'SHELF', data: "HCol4_descn", "name": "HCol4_descn" },
                        { title: 'ARCH', data: "HCol5_descn", "name": "HCol5_descn" },

