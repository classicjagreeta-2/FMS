                                return (moment(data).format("DD/MM/YYYY"));
                            }


                        },
                        { title: 'Remarks ', data: "Remarks", "name": "Remarks" },
                    ],
                    lengthMenu: [
                        [50, 100, 500, -1],
                        ['50', '100', '500', 'Show all']
                    ],
                    dom: 'lBfrtip',
                    buttons: [  
                    {
