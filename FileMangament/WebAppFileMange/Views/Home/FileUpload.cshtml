<div class="page-body">
    @using (Ajax.BeginForm("", "", new AjaxOptions { }, new { Id = "myForm" }))
    {
        <h5 class="card-header-text">Storage Details</h5>

        <div class="card">


            @Html.HiddenFor(x => x.Head.Hierarchy, new { @class = "form-control", @Id = "HId_Hierarchy" })
            @Html.HiddenFor(x => x.Head.Hierarchy2, new { @class = "form-control", @Id = "HId_Hierarchy2" })



            @Html.Partial("_Header", Model)


            <div class="col-lg-12">


                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-form-label">
                            Physical Storage
                        </label>
                        @Html.TextBoxFor(x => x.Head.NoUse, new { @class = "form-control", @Id = "IdPhysicalStorage", @Readonly = true })

                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-form-label">
                            File Name
                        </label>

                        @Html.TextBoxFor(x => x.Head.FileName, new { @class = "form-control", @Id = "IdfileName", @Readonly = true })

                    </div>
                </div>
                <div class="col-md-12">
                    <div class="form-group">
                        <label class="col-form-label">
                            File Location
                        </label>
                        @Html.TextBoxFor(x => x.Head.FilePath, new { @class = "form-control", @Id = "IdFileLocation", @Readonly = true })

                    </div>
                </div>


                <!-- end of general info -->
            </div>



        </div>
        @Html.HiddenFor(x => x.Head.UploadSessionId, new { Value = ViewBag.FromSession, id = "Idsession" })
    }

    <div class="row">
        <div class="col-sm-12">

            <div class="card">

                <div class="card-block tab-icon">
                    <!-- Row start -->
                    <div class="row">


                        <div class="col-lg-12 col-xl-12">
                            <!-- <h6 class="sub-title">Tab With Icon</h6> -->
                            <!-- Nav tabs -->
                            <ul class="nav nav-tabs md-tabs " role="tablist">
                                <li class="nav-item">
                                    <a class="nav-link active" id="tab1" data-toggle="tab" href="#T1" role="tab"><i class="icofont icofont-upload"></i>Upload New Files</a>
                                    <div class="slide"></div>
                                </li>
                                @*<li class="nav-item">
                                        <a class="nav-link" id="tab2" data-toggle="tab" href="#T2" role="tab"><i class="icofont icofont-download "></i>Download Or View Files </a>
                                        <div class="slide"></div>
                                    </li>*@

                            </ul>
                            <!-- Tab panes -->
                            <div class="tab-content card-block">
                                <div class="tab-pane active" id="T1" role="tabpanel">

                                    <div class="card-block">
                                        <div class="file-loading">
                                            <input id="file-Uploder" type="file" multiple>
                                        </div>
                                    </div>



                                    @*<button type="reset" class="btn btn-outline-secondary">Reset</button>*@
                                </div>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="general-info">

                                            <div class="row pull-left">
                                                <div class="col-md-3 d-none">
                                                    <div class="form-group">
                                                        <label class="col-form-label">
                                                            File Session Id
                                                        </label>


                                                        <input type="text" class="form-control" value="@ViewBag.FromSession" disabled />

                                                    </div>
                                                </div>
                                                <div class="col-md-3 d-none">
                                                    <div class="form-group">
                                                        <label class="col-form-label col-xl-12">
                                                            File Count
                                                        </label>
                                                        <input type="text" class="form-control" id="txtfilecount" disabled />
                                                    </div>
                                                </div>
                                                <div class="col-md-5">
                                                    <div class="form-group">
                                                        <label class="col-form-label col-xl-12">
                                                            Uploded  File Count
                                                        </label>
                                                        <input type="text" class="form-control" id="txtUploadedfilecount" disabled />
                                                    </div>
                                                </div>
                                                <div class="col-md-3">
                                                    <div class="form-group">
                                                        <label class="col-form-label col-xl-12">
                                                        </label>
                                                        <button type="submit" id="btnSubmit" class="btn btn-success"><i class="icofont icofont-warning-alt"></i>TRANFER TO SERVER</button>
                                                    </div>
                                                </div>

                                                <!-- end of table col-lg-6 -->
                                                <!-- end of table col-lg-6 -->

                                            </div>


                                            <!-- end of row -->
                                        </div>
                                        <!-- end of general info -->
                                    </div>
                                </div>
                                <div id="kv-error-1" style="margin-top:10px;display:Block"></div>
                                <div id="kv-success-1" class="alert alert-success " style="margin-top:10px;display:none"></div>
                                @*<div class="tab-pane" id="T2" role="tabpanel">
                                        <div class="card-block" id="IdDataList">




                                        </div>
                                    </div>*@<div class="tab-pane" id="T2" role="tabpanel">
                                    <div class="card-block" id="IdDataList">




                                    </div>
                                </div>

                            </div>
                        </div>

                    </div>
                    <!-- Row end -->
                </div>


            </div>
        </div>
    </div>

    <div class="modal fade" id="IdModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Message</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <div class="container"></div>
                <div class="modal-body">


                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="col-form-label">
                                Physical Storage  : <label id="Show_IdPhysicalStorage"></label>
                            </label>

                            <hr style="margin: -3px 0px 1px 1px;">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="col-form-label">
                                File Location : <label id="Show_IdFileLocation"></label>
                            </label>

                            <hr style="margin: -3px 0px 1px 1px;">
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group">
                            <label class="col-form-label">
                                File Names :
                            </label>
                            <ul id="IdFileNames"></ul>

                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <a href="#" data-dismiss="modal" class="btn btn-danger" id="btnRestFiles">Close</a>

                </div>
            </div>
        </div>
    </div>

</div>


