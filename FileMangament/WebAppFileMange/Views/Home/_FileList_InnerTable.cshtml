@model IEnumerable<WebAppFileMange.Models.Table.TRN_Document>
@using WEB_PRO17.Common

@{
    Layout = null;
}

<style>
    .dropdown, .dropup {
        position: unset;
    }


</style>
<link href="~/libraries/assets/css/CheckBoxStyle.css" rel="stylesheet" />
<div class="card-block" style="margin-left: 224px;">

    <div class="dataTables_scroll">


        <div class="table-responsive text-nowrap" id="DivTble">
            <div style="width:500px">

                <table id="Inner-table" class="table table-striped table-bordered nowrap">

                    <thead class="classHaeder">

                        <tr>
                            <th width="4%"> </th>
                            <th style="display:none"> </th>
                            <th style="display:none"> </th>
                            <th width="2%"> SL</th>

                            <th width="5%">File Name</th>
                            @*<th width="5%">File Path</th>*@

                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>


                                    <div class="dropdown-primary dropdown open">

                                        <button class="btn  btn-sm btn-info dropdown-toggle waves-effect waves-light " type="button" id="dropdown-2" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true"> <i class="fa fa-thumb-tack fa-lg" aria-hidden="true"></i></button>
                                        <div class="dropdown-menu" data-dropdown-in="fadeIn" data-dropdown-out="fadeOut">


                                            <a class="dropdown-item waves-light waves-effect" target="_blank"
                                               href="@Url.Action("ShowFile","FMS_Report",new {@ReportURL=item.FullPath})">
                                                <i class="icofont icofont-file-pdf"></i>VIEW
                                            </a>

                                            @*<a class="dropdown-item waves-light waves-effect open-file-modal"
                       data-file="@item.FileName">
                        <i class="icofont icofont-file-pdf"></i> VIEW
                    </a>*@


                                            <a class="dropdown-item waves-light waves-effect"
                                               href="@Url.Action("DownLoadFile","FMS_Report",new {@path=item.FullPath,@FileName=item.FileName})"><i class="icofont icofont-file-pdf"></i>DOWNLOAD</a>
                                            <a class="dropdown-item waves-light waves-effect"
                                               onclick="LoadCheckList(@item.FK_Autoid,'@item.FilePath.Replace("\\","^")','2','@item.FileName')"><i class="icofont icofont-file-pdf"></i>EMAIL</a>

                                        </div>
                                    </div>


                                </td>
                                <td style="display:none">@item.FileName</td>
                                <td style="display:none">@item.FilePath</td>
                                <td> @(Model.ToList().IndexOf(item) + 1)</td>
                                <td>@item.FileName.Substring(0, item.FileName.LastIndexOf('.'))</td>


                            </tr>

                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script src="~/JsProject/TD_ReportModel.js"></script>