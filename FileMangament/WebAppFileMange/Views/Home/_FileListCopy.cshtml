@using System.Data;
@model DataTable
 
@{
    /**/

    ViewBag.Title = @ViewBag.PageName;
}

<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-bs4/css/dataTables.bootstrap4.min.css">
<link rel="stylesheet" type="text/css" href="~/libraries/assets/pages/data-table/css/buttons.dataTables.min.css">
<link href="~/libraries/msg/jquery-confirm.min.css" rel="stylesheet" />
<link href="~/libraries/TableRowDesign.css" rel="stylesheet" />

<link rel="stylesheet" href="~/libraries/bootstrapTale/src/extensions/fixed-columns/bootstrap-table-fixed-columns.css">
<script src="~/libraries/bootstrapTale/src/extensions/fixed-columns/bootstrap-table-fixed-columns.js"></script>


<!-- Data Table Css -->

<link rel="stylesheet" type="text/css" href="~/libraries/bower_components/datatables.net-responsive-bs4/css/responsive.bootstrap4.min.css">

<style>
    .modal-backdrop {
        opacity: 0.5 !important;
    }

    .dataTables_length {
        margin: 0px 0px -45px 6px;
    }

    div.dt-buttons {
        margin: 0px 0px 0px 188px;
    }

    .hiddenRow {
        padding: 0 !important;
    }
</style>


<link href="~/JsProject/MyselfOverIdeStyle.css" rel="stylesheet" />

<div class="card">
     

    <div class="card-block" id="divcontainer">
        @*<a href="@Url.Action("ExcelExport", "TD_Report", new { Loca = "AGRI" })" id="btnDowlaodExcelRefresh"></a>*@
        <div class="dt-responsive table-responsive">
            <table id="ajax-table" class="table table-striped table-bordered nowrap" style="width:100%">

                <thead class="classHaeder">

                    <tr>
                        <th>  </th>
                        <th style="display:none"> </th>
                        <th>Floor </th>
                        <th>Rack</th>
                        <th>Shelf</th>
                        <th>Arch</th>

                        <th>Company</th>
                        <th>Unit</th>
                        <th>Department</th>
                        <th>Type</th>
                        <th>Year</th>
                    </tr>
                </thead>
                <tbody>
                   @foreach (DataRow item in Model.Rows)
                   {

                       {
                        <tr>
                            <td class="details-control" style="height: 32px;">

                                @*<button type="button" data-toggle="modal" data-target="#addModal" class="AddAmount btn btn-success btn-xs text-center loading" title="Edit/Update"><i class="icon-quill2"></i></button>*@
                                <div class="table-expandable-arrow"></div>

                            </td>
                            <td style="display:none">@item["Autoid"] </td>
                            <td>@item["HCol2_descn"]</td>
                            <td>@item["HCol3_descn"]</td>   
                            <td>@item["HCol4_descn"]</td>   
                            <td>@item["HCol5_descn"]</td>                            
                             
                            <td>@item["H2Col2_descn"]</td>    
                            <td>@item["H2Col3_descn"]</td>    
                            <td>@item["H2Col4_descn"]</td>
                            <td>@item["H2Col5_descn"]</td>      
                            <td>@item["H2Col6_descn"]</td>        
                        </tr>
                       }
                   }
                </tbody>
            </table>
        </div>


    </div>


    <div class="modal fade" id="IdModal" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Modal 4</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">×</button>
                </div>
                <div class="container"></div>
                <div class="modal-body">Content for the dialog / modal goes here.</div>
                <div class="modal-footer">
                    <a href="#" data-dismiss="modal" class="btn">Close</a>
                    <a href="#" class="btn btn-primary">Save changes</a>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="default-Modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Head Selection </h5>
                <button type="button" class="btn btn-danger HeadModelClose">X</button>
            </div>
            <div class="modal-body">
                <div class="j-unit">
                    <div class="j-input">
                        <div class="checkbox-zoom zoom-primary">
                            <div class="form-group">
                            </div>
                            <div class="checkbox-fade fade-in-primary">

                                <input type="hidden" id="HAutoId" />
                                <input type="hidden" id="HFmId" />

                                <div id="lblCheckBoxList">

                                </div>



                            </div>

                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger waves-effect HeadModelClose">Close</button>
                @*<button type="button" class="btn btn-primary  waves-effect btnpdfdownload">PDF</button>*@
                <button type="button" class="btn btn-primary  waves-effect btnSendMail"> <i class="icofont icofont-email"></i>Email</button>
            </div>
        </div>
    </div>
</div>
@section scripts{

    <link rel="stylesheet" href="~/t2/css/fixedColumns.dataTables.min.css" />


    <script src="~/libraries/bower_components/datatables.net/js/jquery.dataTables.min.js"></script>
